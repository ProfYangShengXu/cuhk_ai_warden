# ===== AI 导员 · 环境配置 =====
# 复制本文件为 .env 并填入你的信息（.env 不要发给任何人/不要进 git）

# ---- 学校账号（必填）----
CUHK_STUDENT_ID=你的学号
CUHK_BB_PASSWORD=你的BB密码
# BB 登录域名（港中深固定 cuhksz，一般不用改）
CUHK_BB_DOMAIN=cuhksz

# ---- QQ 邮箱（必填，用于接收学校转发邮件）----
QQ_EMAIL=你的QQ邮箱@qq.com
# QQ 邮箱授权码：网页版邮箱 → 设置 → 账户 → 开启 IMAP/SMTP → 生成（16位，不是QQ密码）
QQ_IMAP_AUTHCODE=你的16位授权码

# ---- 以下一般不用改 ----
CUHK_STS_AUTH_URL=https://STS.cuhk.edu.cn/adfs/oauth2/authorize?response_type=code&client_id=4b71b947-7b0d-4611-b47e-0ec37aabfd5e&redirect_uri=https%3A%2F%2Fbb.cuhk.edu.cn%2Fwebapps%2Fbb-SSOIntegrationOAuth2-BBLEARN%2FauthValidate%2FgetCode
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
